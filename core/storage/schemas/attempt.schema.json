{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "schema": {
      "enum": [
        "mosaic.scattering.attempt",
        "mosaic.residual_field.attempt"
      ]
    },
    "schema_version": {"const": 1},
    "run_digest": {"type": "string"},
    "stage": {
      "enum": [
        "scattering",
        "residual_field"
      ]
    },
    "work_unit_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "attempt_id": {"type": "string"},
    "chunk_id": {"type": "integer"},
    "payload_path": {"type": "string"},
    "payload_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "file_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "payload_nbytes": {"type": "integer"},
    "scientific_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "execution_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "qspace_plan_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "backend_policy_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "source_structure_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "interval_id": {"type": "integer"},
    "expected_interval_ids": {"type": "array", "items": {"type": "integer"}},
    "parameter_digest": {"type": "string"},
    "partition_id": {"type": "integer"},
    "point_start": {"type": "integer"},
    "point_stop": {"type": "integer"},
    "interval_ids": {"type": "array", "items": {"type": "integer"}},
    "partition_plan_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "source_scattering_commit_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "source_replacement_digest": {
      "anyOf": [
        {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        {"type": "null"}
      ]
    },
    "expected_output_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "contribution_reciprocal_points": {"type": "integer"},
    "runtime_provenance": {"type": "object"}
  },
  "required": [
    "schema",
    "schema_version",
    "run_digest",
    "stage",
    "work_unit_digest",
    "attempt_id",
    "chunk_id",
    "runtime_provenance",
    "payload_path",
    "payload_sha256",
    "file_sha256",
    "payload_nbytes"
  ],
  "type": "object"
}
