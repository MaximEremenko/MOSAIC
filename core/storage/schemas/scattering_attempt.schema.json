{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "schema": {"const": "mosaic.scattering.attempt"},
    "schema_version": {"const": 1},
    "run_digest": {"type": "string"},
    "stage": {"const": "scattering"},
    "work_unit_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "attempt_id": {"type": "string"},
    "interval_id": {"type": "integer"},
    "chunk_id": {"type": "integer"},
    "scientific_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "execution_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "qspace_plan_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "backend_policy_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "source_structure_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "contribution_reciprocal_points": {"type": "integer"},
    "runtime_provenance": {"type": "object"},
    "payload_path": {"type": "string"},
    "payload_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "file_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "payload_nbytes": {"type": "integer"}
  },
  "required": [
    "schema",
    "schema_version",
    "run_digest",
    "stage",
    "work_unit_digest",
    "attempt_id",
    "interval_id",
    "chunk_id",
    "scientific_digest",
    "execution_digest",
    "qspace_plan_digest",
    "backend_policy_digest",
    "source_structure_digest",
    "contribution_reciprocal_points",
    "runtime_provenance",
    "payload_path",
    "payload_sha256",
    "file_sha256",
    "payload_nbytes"
  ],
  "type": "object"
}
