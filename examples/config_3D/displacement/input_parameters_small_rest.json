{
  "schema_version": 2,
  "paths": {
    "config_root": ".",
    "structure_file": "Catio3_small.rmc6f",
    "output_directory": "./output_disp_small_rest",
    "average_structure_file": "Catio3_small_average.rmc6f"
  },
  "structure": {
    "dimension": 3,
    "cell_limits": {
      "min": [
        0,
        0,
        0
      ],
      "max": [
        7,
        7,
        7
      ]
    }
  },
  "reciprocal_space": {
    "intervals": [
      {
        "limit": [
          20.0,
          20.0,
          20.0
        ],
        "subvolume_step": [
          5.0,
          5.0,
          5.0
        ]
      }
    ],
    "mask": {
      "equation": "(((Mod(h,1.0) - 0.5)**2 + (Mod(k,1.0) - 0.5)**2) > (0.1876)**2) & (((Mod(h,1.0) - 0.5)**2 + (Mod(k,1.0) - 0.5)**2 + (Mod(l,1.0) - 0.5)**2) > (0.2501)**2)"
    }
  },
  "processing": {
    "mode": "displacement",
    "method": "from_average",
    "num_chunks": 4,
    "fresh_start": true,
    "run_postprocessing": true,
    "points": [
      {
        "selector": {
          "element": "O",
          "reference_number": 2
        },
        "window": {
          "dist_from_atom_center": [
            0.5,
            0.5,
            0.5
          ],
          "step_in_angstrom": [
            0.05,
            0.05,
            0.05
          ]
        }
      },
      {
        "selector": {
          "element": "O",
          "reference_number": 3
        },
        "window": {
          "dist_from_atom_center": [
            0.5,
            0.5,
            0.5
          ],
          "step_in_angstrom": [
            0.05,
            0.05,
            0.05
          ]
        }
      },
      {
        "selector": {
          "element": "O",
          "reference_number": 4
        },
        "window": {
          "dist_from_atom_center": [
            0.5,
            0.5,
            0.5
          ],
          "step_in_angstrom": [
            0.05,
            0.05,
            0.05
          ]
        }
      }
    ],
    "decoder": {
      "source": "cache",
      "cache_path": "./output_disp_small_all/processed_point_data"
    }
  },
  "runtime": {
    "dask": {
      "backend": "cuda-local",
      "max_workers": 4,
      "threads_per_worker": 8,
      "processes": false,
      "worker_wait_timeout": "120s"
    },
    "scattering_weights": {
      "kind": "ones",
      "calculator": "default"
    }
  }
}
